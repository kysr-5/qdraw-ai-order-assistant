# Do not commit a real API key. Copy this file to .env and fill in the values locally.

# Text model: requirement extraction and merchant-feedback revision briefs.
# DeepSeek example:
# TEXT_AI_API_URL=https://api.deepseek.com/chat/completions
# TEXT_AI_MODEL=deepseek-v4-flash
