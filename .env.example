# 配置后，后端会调用兼容 OpenAI Chat Completions 的模型服务。
# 选择其中一个配置方案，不要把真实密钥提交到 Git。

# DeepSeek 示例：
# AI_API_URL=https://api.deepseek.com/chat/completions
# AI_MODEL=deepseek-v4-flash

# 阿里云百炼示例，将 {WorkspaceId} 换成业务空间 ID：
# AI_API_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/chat/completions
# AI_MODEL=qwen-plus

AI_API_URL=
AI_API_KEY=
AI_MODEL=

# 可选：默认 3000。
PORT=3000
