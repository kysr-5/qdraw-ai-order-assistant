# Do not commit a real API key. Copy this file to .env and fill in the values locally.

# Text model: requirement extraction and merchant-feedback revision briefs.
# Existing AI_API_* values remain supported as a backward-compatible alias.
# DeepSeek example:
# TEXT_AI_API_URL=https://api.deepseek.com/chat/completions
# TEXT_AI_MODEL=deepseek-chat
TEXT_AI_API_URL=
TEXT_AI_API_KEY=
TEXT_AI_MODEL=

# Visual model: final artwork review. Alibaba Cloud Model Studio example:
# VISION_AI_API_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/chat/completions
# VISION_AI_MODEL=qwen3.7-plus
VISION_AI_API_URL=
VISION_AI_API_KEY=
VISION_AI_MODEL=

# Legacy text-model configuration, optional.
AI_API_URL=
AI_API_KEY=
AI_MODEL=

PORT=3000
