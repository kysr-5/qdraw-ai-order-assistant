# VISION_AI_MODEL=qwen3.7-plus
VISION_AI_API_URL=
VISION_AI_API_KEY=
VISION_AI_MODEL=

# Legacy text-model configuration, optional.
AI_API_URL=
AI_API_KEY=
AI_MODEL=

PORT=3000
